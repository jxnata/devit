{
  "name": "devit",
  "version": "0.5.1",
  "description": "A small team of AI agents for your projects: personas, routines, shared memory and a kanban board.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devit": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/devit",
    "docs": "bun scripts/cli-docs.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ]
}
